    {"content": {"id": "hint.es.past.yo", "revision": 1}, "blocks": [{"kind": "paragraph", "spans": [{"language": "en", "text": "Look for the yo ending of regular -ar verbs: -é."}]}]},
    {"content": {"id": "explanation.es.ayer", "revision": 1}, "blocks": [{"kind": "paragraph", "spans": [{"language": "en", "text": "Ayer means yesterday."}]}]},
    {"content": {"id": "explanation.es.past.yo", "revision": 1}, "blocks": [{"kind": "paragraph", "spans": [{"language": "en", "text": "The ending -é marks yo in the indefinido: estudié. Keep the written accent."}]}]},
