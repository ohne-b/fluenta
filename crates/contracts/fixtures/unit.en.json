      "blocks": [
        {"kind": "paragraph", "spans": [{"language": "en", "text": "Use the indefinido when you present a past action as completed. With regular -ar verbs, the yo form ends in -é."}]},
        {"kind": "example", "spans": [{"language": "es", "text": "Ayer estudié para el examen."}], "speech": {"id": "speech.es.past.exam", "revision": 1}},
        {"kind": "paragraph", "spans": [{"language": "en", "text": "English past-tense forms do not map one-to-one to Spanish tenses. Here, the completed viewpoint is what matters."}]}
      ]
    },
    {"content": {"id": "material.es.past.gap", "revision": 1}, "blocks": [{"kind": "paragraph", "spans": [{"language": "es", "text": "Ayer yo _____ para el examen. (estudiar)"}]}]},
