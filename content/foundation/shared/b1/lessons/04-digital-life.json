          "spans": [
            {
              "language": "es",
              "text": "En nuestro instituto se permite usar el móvil para algunas actividades. Fuera de esas actividades debe permanecer guardado. El objetivo no es prohibir la tecnología, sino evitar distracciones."
            }
          ],
          "speech": null
