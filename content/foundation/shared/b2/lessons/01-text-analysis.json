    {
      "content": {
        "id": "es.b2.text-analysis.produce",
        "revision": 1
      },
      "instruction": {
        "language": "es",
        "text": "Analiza cómo este fragmento intenta convencer al lector: «No necesitamos más promesas. Necesitamos decisiones. Necesitamos actuar hoy.» Relaciona al menos dos observaciones con sus posibles efectos."
      },
      "objectives": [
        {
          "id": "es.b2.text-analysis.objective",
          "revision": 1
        }
      ],
