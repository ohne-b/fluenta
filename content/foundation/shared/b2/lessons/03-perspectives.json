    {
      "content": {
        "id": "es.b2.perspectives.produce",
        "revision": 2
      },
      "instruction": {
        "language": "es",
        "text": "Compara estas posturas sin generalizar: Marta propone voluntariado escolar obligatorio para ampliar la participación. Diego defiende la elección personal para mantener la motivación. Explica un punto común y una diferencia, y después justifica tu posición."
      },
      "objectives": [
        {
          "id": "es.b2.perspectives.objective",
          "revision": 2
        }
